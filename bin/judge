#!/usr/bin/env ruby
# frozen_string_literal: true

Encoding.default_external = Encoding::UTF_8

# Usage: judge <problem> <solution.rb> [--json] [--verbose] [--agent]
#   e.g. judge 01 answer.rb
#
# 公開サンプル (problems/<id>/samples) と非公開テスト (private/<id>/tests) で解答を採点します。
# - サンプルが失敗したときは、期待出力と実際の出力を表示します。
# - 既定の表示は、非公開テストもケースごとの合否と失敗の種類を出します（入力は出さない）。
# - --json と --verbose は運営者・ランナー向けで、非公開もケースごとに出します（--verbose は失敗の中身も）。
# - --agent はエージェント向けです。公開サンプルの詳細と `hidden: n/m passed` だけを出します。
#   非公開のケース名も失敗の種類も出しません。--json や --verbose より優先します。
# - 全ケース正解のときだけバイト数を表示します。
#
# 非公開テストの場所は環境変数 GOLF_PRIVATE_DIR で変えられます（既定: <repo>/private）。
# 1ケースの制限時間は problem.yml の time_limit_per_case_sec。GOLF_TIME_LIMIT があればそちらを使う。
# 解答はサンドボックスの中で実行し、リポジトリと非公開テストは見えません（GOLF_SANDBOX、lib/golf_sandbox.rb 参照）。

require "json"
require "yaml"
require_relative "../lib/golf_sandbox"

ROOT = File.expand_path("..", __dir__)
PRIVATE_DIR = GolfSandbox.private_dir

def utf8(s)
  str = s.to_s.dup.force_encoding(Encoding::UTF_8)
  str.valid_encoding? ? str : str.scrub
end

def normalize(s) = utf8(s).lines.map(&:rstrip).join("\n").rstrip

def score(path) = File.binread(path).delete_suffix("\n").bytesize

# 解答を隔離して実行する（lib/golf_sandbox.rb）。標準入力だけを渡す。
def run(solution, input) = GolfSandbox.run_file(solution, input, time_limit: TIME_LIMIT)

args = ARGV.reject { _1.start_with?("--") }
# --agent は作業ディレクトリの ./judge と MCP から付く。後続の --json / --verbose では詳細を開けない。
agent = ARGV.include?("--agent")
json = ARGV.include?("--json") && !agent
verbose = ARGV.include?("--verbose") && !agent
problem, solution = args
abort "Usage: judge <problem> <solution.rb> [--json] [--verbose] [--agent]" unless problem && solution
abort "No such file: #{solution}" unless File.file?(solution)
solution = File.expand_path(solution)

public_dir = Dir[File.join(ROOT, "problems", "#{problem}*")].first
abort "No such problem: #{problem}" unless public_dir
slug = File.basename(public_dir)
meta = YAML.safe_load_file(File.join(public_dir, "problem.yml"))
raw_limit = ENV["GOLF_TIME_LIMIT"]
raw_limit = meta["time_limit_per_case_sec"] if raw_limit.nil? || raw_limit.empty?
TIME_LIMIT = Float(raw_limit || 5)

cases = Dir[File.join(public_dir, "samples", "*.in")].sort.map { [:sample, _1] } +
        Dir[File.join(PRIVATE_DIR, slug, "tests", "*.in")].sort.map { [:hidden, _1] }
abort "No test cases found for #{slug}" if cases.none? { _1[0] == :hidden }

results = cases.map do |kind, input_path|
  name = File.basename(input_path, ".in")
  input = File.read(input_path)
  expected = File.read(input_path.sub(/\.in\z/, ".out"))
  status, actual, err = run(solution, input)
  status = :wrong_answer if status == :ok && normalize(actual) != normalize(expected)
  status = :accepted if status == :ok
  { name:, kind:, status:, input:, expected:, actual:, stderr: err }
end

passed = results.count { _1[:status] == :accepted }
accepted = passed == results.size
bytes = score(solution)

def show_failure_detail(result)
  puts "    input:    #{result[:input].inspect[0, 300]}"
  puts "    expected: #{normalize(result[:expected]).inspect[0, 300]}"
  puts "    actual:   #{normalize(result[:actual]).inspect[0, 300]}"
  err = utf8(result[:stderr])
  puts "    stderr:   #{err.lines.first(3).join.strip}" unless err.empty?
end

def report_summary(slug, passed, total, accepted, bytes)
  puts
  puts "#{slug}: #{passed}/#{total} passed"
  puts accepted ? "Score: #{bytes} bytes" : "Not accepted (#{bytes} bytes)"
end

if json
  puts JSON.generate(
    problem: slug, accepted:, passed:, total: results.size, bytes: accepted ? bytes : nil,
    cases: results.map { { name: _1[:name], kind: _1[:kind], status: _1[:status] } },
  )
elsif agent
  results.each do |r|
    next unless r[:kind] == :sample

    if r[:status] == :accepted
      puts "  PASS #{r[:name]}"
    else
      puts "  FAIL #{r[:name]} (#{r[:status]})"
      show_failure_detail(r)
    end
  end
  hidden = results.select { _1[:kind] == :hidden }
  hidden_passed = hidden.count { _1[:status] == :accepted }
  puts
  puts "hidden: #{hidden_passed}/#{hidden.size} passed"
  report_summary(slug, passed, results.size, accepted, bytes)
else
  results.each do |r|
    label = r[:kind] == :sample ? r[:name] : "hidden/#{r[:name]}"
    if r[:status] == :accepted
      puts "  PASS #{label}"
      next
    end
    puts "  FAIL #{label} (#{r[:status]})"
    next unless r[:kind] == :sample || verbose

    show_failure_detail(r)
  end
  report_summary(slug, passed, results.size, accepted, bytes)
end
exit(accepted ? 0 : 1)
